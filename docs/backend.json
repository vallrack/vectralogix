
{
  "entities": {
    "Zone": {
      "title": "Zona Geográfica",
      "description": "Representa una zona delimitada en el mapa. Acceso total de lectura/escritura para operadores autenticados.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["polygon", "rect", "circle"] },
        "color": { "type": "string" },
        "coordinates": { "type": "array", "description": "Lista de puntos lat/lng." },
        "zoom": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type", "color", "coordinates"]
    },
    "Route": {
      "title": "Ruta de Entrega",
      "description": "Secuencia de paradas optimizada. Acceso total de lectura/escritura para operadores autenticados.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stops": { "type": "array" },
        "distance": { "type": "number" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "stops"]
    },
    "Driver": {
      "title": "Conductor de Flota",
      "description": "Personal operativo. Acceso total de lectura/escritura para operadores autenticados.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vehicleType": { "type": "string", "enum": ["car", "van", "truck", "motorcycle"] },
        "isAvailable": { "type": "boolean" },
        "performance": { "type": "number" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "vehicleType", "isAvailable"]
    },
    "Order": {
      "title": "Pedido Logístico",
      "description": "Envío gestionable. Acceso total de lectura/escritura para operadores autenticados.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in-transit", "delivered", "cancelled"] },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "address", "status"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/zones/{zoneId}": {
      "schema": "#/backend/entities/Zone",
      "description": "Zonas tácticas. Lectura/Escritura abierta para usuarios logueados."
    },
    "/routes/{routeId}": {
      "schema": "#/backend/entities/Route",
      "description": "Planeación logística. Lectura/Escritura abierta para usuarios logueados."
    },
    "/drivers/{driverId}": {
      "schema": "#/backend/entities/Driver",
      "description": "Gestión de flota. Lectura/Escritura abierta para usuarios logueados."
    },
    "/orders/{orderId}": {
      "schema": "#/backend/entities/Order",
      "description": "Pedidos activos. Lectura/Escritura abierta para usuarios logueados."
    }
  }
}
